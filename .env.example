# ─── Coolify / docker-compose env vars ──────────────────────────────
# Copier en `.env` (jamais committé) ou renseigner via l'UI Coolify.
# Les valeurs vides ici sont des placeholders — toutes les vraies
# valeurs doivent être renseignées avant le premier `docker compose up`.

# CORS — origins autorisés (séparés par virgule, pas de wildcard en prod)
CORS_ORIGINS=https://app.tondomaine.com,https://www.tondomaine.com

# URL publique du backend (pour les liens dans les emails et /files)
APP_BASE_URL=https://api.tondomaine.com

# URL publique du frontend (utilisée pour les liens d'activation dans
# les mails d'invitation : https://<FRONTEND_BASE_URL>/invitation/<token>)
FRONTEND_BASE_URL=https://app.tondomaine.com

# Mailer SMTP
MAILER_FROM=noreply@tondomaine.com
MAILER_HOST=smtp.sendgrid.net
MAILER_PORT=587
MAILER_STARTTLS=REQUIRED
MAILER_USERNAME=apikey
MAILER_PASSWORD=

# JWT
JWT_ISSUER=https://api.tondomaine.com
# Les clés vivent dans ./secrets/jwt-public.pem et ./secrets/jwt-private.pem
# Cf. README "Préparer les clés JWT".

# Stockage fichiers
# `local` = volume Docker persistant (par défaut)
# `s3`    = AWS S3 ou compatible (Wasabi, Cellar, MinIO, …)
FILE_STORAGE_BACKEND=local

# S3 (uniquement si FILE_STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=eu-west-3
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
